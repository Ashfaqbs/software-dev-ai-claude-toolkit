    "python-fastapi": "Python 3.12 + FastAPI + AI/ML rules and skills",
    "javascript-react": "Express.js + React rules and skills",
    "ai-ml": "RAG/agent/MCP skill packs not tied to a specific language stack"
  },
  "rules": [
    { "id": "coding-style", "group": "general" },
    { "id": "java-springboot", "group": "java-springboot" },
    { "id": "python-backend-ai", "group": "python-fastapi" },
    { "id": "javascript", "group": "javascript-react" },
    { "id": "databases", "group": "general" },
    { "id": "infra", "group": "general" },
    { "id": "git-workflow", "group": "general" },
    { "id": "testing", "group": "general" },
    { "id": "security", "group": "general" }
  ],
